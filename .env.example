# Copy this file to .env and fill in the values.
# .env is ignored by Git, so real keys never reach the repository.
# Without these values the app still runs, in demo mode only.

# --- Browser (Vite passes only VITE_* variables to browser code) ---
# Supabase dashboard -> Project Settings -> API.
# The project URL and the public anon key are meant for the browser:
# Row Level Security in the database is what protects the data.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Server function /api/ai (never give these the VITE_ prefix) ---
# Claude API key from console.anthropic.com -> API keys.
# On Netlify set it in Site configuration -> Environment variables.
ANTHROPIC_API_KEY=
# Optional: another Claude model for the AI features (default: claude-opus-5-5).
ANTHROPIC_MODEL=
