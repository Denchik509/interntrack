# Copy this file to .env and fill in the values.
# .env is ignored by Git, so real keys never reach the repository.

# Supabase dashboard -> Project Settings -> API.
# The project URL and the public (anon / publishable) key are meant for the
# browser: Row Level Security is what protects the data.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Vite exposes only VITE_* variables to browser code.
# Server-side secrets (the LLM API key, stage 5) must never get that prefix.
